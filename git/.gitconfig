[user]
	name = Y4M06
	email = 93231355+Y4M06@users.noreply.github.com.
[core]
	editor = nvim
[init]
	defaultbranch = main
[safe]
	directory = /run/media/yamo/storage/pacmanCache/*
	directory = /run/media/yamo/dev/code/theOdinProject/git
[color]
	ui = auto
[pull]
	rebase = false
[alias]
	lgb = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset%n' --abbrev-commit --date=relative --branches
  co = checkout
  cob = checkout -b
  coo = !git fetch && git checkout
  br = branch
  brd = branch -d
  st = status
  aa = add -A .
  unstage = reset --soft HEAD^
  cm = commit -m
  amend = commit --amend -m
  fix = commit --fixup
  undo = reset HEAD~1
  rv = revert
  cp = cherry-pick
  pu = !git push origin `git branch --show-current`
  fush = push -f
  flush = push --force-with-lease
  mg = merge --no-ff
  rb = rebase
  rbc = rebase --continue
  rba = rebase --abort
  rbs = rebase --skip
  rom = !git fetch && git rebase -i origin/master --autosquash
  save = stash push
  pop = stash pop
  apply = stash apply
  rl = reflog
[url "git@github.com:"]
	insteadOf = https://github.com/
